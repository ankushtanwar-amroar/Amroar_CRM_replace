{
  "info": {
    "_postman_id": "df-public-apis-phase-81-66",
    "name": "DocFlow Public APIs",
    "description": "DocFlow public-facing APIs for tenant integrations.\n\nCovers:\n\u2022 Templates\n\u2022 Packages (list / detail / send)\n\u2022 Generate Links (single doc & package mode)\n\nEvery routing_mode \u00d7 delivery_mode combination is included as a separate, ready-to-import request. Authentication is via the `X-API-Key` header \u2014 when present, the backend auto-resolves the tenant (Phase 81.64). The legacy `?tenant_id=...` query param remains supported for backward compatibility.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "https://template-api-pub.preview.emergentagent.com",
      "type": "string",
      "description": "DocFlow API base URL \u2014 change to your tenant's host (e.g. https://app.example.com)."
    },
    {
      "key": "x_api_key",
      "value": "REPLACE_WITH_YOUR_API_KEY",
      "type": "string",
      "description": "Issued from Settings \u2192 API Keys. Bound to a tenant_id; auto-resolves the tenant on every request."
    },
    {
      "key": "tenant_id",
      "value": "",
      "type": "string",
      "description": "Optional. Only needed when X-API-Key is NOT used (legacy)."
    },
    {
      "key": "template_id",
      "value": "REPLACE_WITH_TEMPLATE_ID",
      "type": "string",
      "description": "Template UUID. Pull from `GET /api/docflow/public/templates`."
    },
    {
      "key": "package_id",
      "value": "REPLACE_WITH_PACKAGE_ID",
      "type": "string",
      "description": "Package run UUID. Pull from `GET /api/public/packages`."
    },
    {
      "key": "document_id",
      "value": "<your-document-id>",
      "type": "string"
    }
  ],
  "auth": {
    "type": "apikey",
    "apikey": [
      {
        "key": "key",
        "value": "X-API-Key",
        "type": "string"
      },
      {
        "key": "value",
        "value": "{{x_api_key}}",
        "type": "string"
      },
      {
        "key": "in",
        "value": "header",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Templates",
      "description": "Public template metadata. Use the response's `field_placements` to wire up CRM mappings \u2014 merge fields ship a `merge_source: { object, field_name }` block (Phase 81.65).",
      "item": [
        {
          "name": "List Active Templates",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{x_api_key}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/docflow/public/templates",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "docflow",
                "public",
                "templates"
              ]
            },
            "description": "Returns active+latest templates for the tenant bound to the API key.\n\nLegacy fallback: pass `?tenant_id={{tenant_id}}` if not using a key."
          }
        },
        {
          "name": "List Active Templates (Legacy tenant_id query)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/docflow/public/templates?tenant_id={{tenant_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "docflow",
                "public",
                "templates"
              ],
              "query": [
                {
                  "key": "tenant_id",
                  "value": "{{tenant_id}}"
                }
              ]
            }
          }
        }
      ]
    },
