            "body": {
              "mode": "raw",
              "raw": "{\n  \"package_id\": \"{{package_id}}\",\n  \"routing_mode\": \"sequential\",\n  \"delivery_mode\": \"email\",\n  \"recipients\": [\n    {\n      \"id\": \"r1\",\n      \"name\": \"Alice Signer\",\n      \"email\": \"alice@example.com\",\n      \"phone\": \"+15551112222\",\n      \"role\": \"signer\",\n      \"routing_order\": 1\n    },\n    {\n      \"id\": \"r2\",\n      \"name\": \"Bob Approver\",\n      \"email\": \"bob@example.com\",\n      \"phone\": \"+15553334444\",\n      \"role\": \"approver\",\n      \"routing_order\": 2\n    }\n  ],\n  \"field_assignments\": [\n    {\n      \"template_id\": \"{{template_id}}\",\n      \"fields\": [\n        { \"field_id\": \"signature_1\", \"recipient_id\": \"r1\" },\n        { \"field_id\": \"approval_1\", \"recipient_id\": \"r2\" }\n      ]\n    }\n  ],\n  \"template_merge_fields\": [\n    {\n      \"template_id\": \"{{template_id}}\",\n      \"merge_fields\": {\n        \"first_name\": \"Alice\",\n        \"company\": \"Acme Corp\"\n      }\n    }\n  ],\n  \"authentication\": { \"otp_required\": true }\n}"
            }
